# ---------------------------------------------------------------------------
# 3. Admin — không CSP (xem giải thích ở mục 2), nhưng khoá chặt phần còn lại.
# ---------------------------------------------------------------------------
/admin/*
  X-Robots-Tag: noindex, nofollow
  # DENY chứ không SAMEORIGIN: trang này giữ GitHub token, không có lý do gì để nó nằm
  # trong iframe của bất kỳ ai, kể cả của chính kinkay.vn.
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cache-Control: no-store
